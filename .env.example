# ─── SmartSales Bot — API Keys ────────────────────────────
# Copy this file to .env and fill in your keys.
# At least ONE of the two must be set for the LLM to respond.

# Gemini (Primary LLM) — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (Backup LLM) — get a free key at https://openrouter.ai/keys
OPEN_ROUTER_KEY=

# (Optional) Override the default OpenRouter model
# OPENROUTER_MODEL=cohere/north-mini-code:free

# (Optional) Override the default Gemini model
# GEMINI_MODEL=gemini-3.6-flash
