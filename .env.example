# ─── SmartSales Bot — API Keys ────────────────────────────
# Copy this file to .env and fill in your keys.
# At least ONE of the two must be set for the LLM to respond.

# OpenRouter (primary LLM) — get a free key at https://openrouter.ai/keys
OPEN_ROUTER_KEY=

# Gemini (backup LLM) — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Optional) Override the default OpenRouter model
# OPENROUTER_MODEL=cohere/north-mini-code:free
